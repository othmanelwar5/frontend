NEXT_PUBLIC_SITE_URL=https://mymizan.shop
NEXT_PUBLIC_API_URL=https://api.mymizan.shop
MYMIZAN_API_URL=https://api.mymizan.shop

# Frontend service (Easypanel storefront) — browser pixels via /env.js
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
NEXT_PUBLIC_ENABLE_PIXELS=true

# Backend API service (Easypanel api) — server-side CAPI on order create
# Keep BOTH pixel id + access token for each platform (do not remove pixel ids).
# META_PIXEL_ID=
# META_ACCESS_TOKEN=
# META_TEST_EVENT_CODE=
# TIKTOK_PIXEL_ID=
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_TEST_EVENT_CODE=
# SNAP_PIXEL_ID=
# SNAP_ACCESS_TOKEN=
# CAPI_ENABLED=true

# Backend admin dashboard auth
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Backend database
DATABASE_URL=postgres://user:password@host:5432/mymizan

# Backend order export
ORDER_WEBHOOK_URL=

# Backend IP quality validation
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb
MAXMIND_ASN_DB_PATH=/app/data/GeoLite2-ASN.mmdb
MAXMIND_ANONYMOUS_IP_DB_PATH=/app/data/GeoIP2-Anonymous-IP.mmdb
VPN_DETECTION_API_KEY=
VPN_DETECTION_API_URL=
TRUSTED_PROXY_IPS=
